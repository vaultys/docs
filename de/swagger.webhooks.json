        "requestBody": {
          "description": "Details of the created membership.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "description": "Type of webhook event."
                  },
                  "signature": {
                    "type": "string",
                    "description": "Signature of the webhook."
                  },
                  "data": {
                    "$ref": "#/components/schemas/Membership"
                  }
                },
                "required": [
                  "event",
                  "signature",
                  "data"
